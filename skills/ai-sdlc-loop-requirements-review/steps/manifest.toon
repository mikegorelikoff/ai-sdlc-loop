budgets:
  context_max_tokens: 8000
  min_context_savings_percent: 15
  step_max_tokens: 3000
entrypoints:
  clarify[1]: context
  complete[1]: handoff
  execute[1]: review
  handoff[1]: handoff
  prepare[1]: scope
  route[1]: context
  validate[1]: validate
schema: ai-sdlc-skill-steps/v2
skill: ai-sdlc-loop-requirements-review
steps[5]:
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: prepare
      roles[1]: business-analyst
    context:
      budget_tokens: 8000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[0]:
    gates[2]: inputs,scope
    id: scope
    load: required
    max_attempts: 1
    max_tokens: 3000
    on_failure: block
    operation: bound-review
    outputs[2]: source-inventory,coverage-inventory
    path: steps/01-scope.md
    reason: bound evidence and review dimensions
    side_effect: none
    type: analysis
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: clarify,route
      roles[1]: business-analyst
    context:
      budget_tokens: 8000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: scope
    gates[2]: context-sufficiency,source-traceability
    id: context
    load: required
    max_attempts: 1
    max_tokens: 3000
    on_failure: block
    operation: compile-context
    outputs[2]: context-set,source-evidence
    path: steps/02-context.md
    reason: select sufficient requirements evidence
    side_effect: none
    type: context
  - capabilities[2]: filesystem.read,filesystem.write
    commit_boundary: after-step
    condition:
      actions[0]:
      phases[1]: execute
      roles[1]: business-analyst
    context:
      budget_tokens: 8000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: context
    gates[3]: dependencies,context-sufficiency,authorization
    id: review
    load: on-demand
    max_attempts: 1
    max_tokens: 3000
    on_failure: block
    operation: review-requirements
    outputs[2]: requirements-review,findings
    path: steps/03-review.md
    reason: identify typed delivery and testability gaps
    side_effect: workspace-write
    type: action
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: validate
      roles[1]: business-analyst
    context:
      budget_tokens: 8000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: review
    gates[3]: evidence,readiness,resolution
    id: validate
    load: before-completion
    max_attempts: 1
    max_tokens: 3000
    on_failure: block
    operation: validate-review
    outputs[2]: validation-result,remaining-gaps
    path: steps/04-validate.md
    reason: enforce evidence-backed requirements readiness
    side_effect: none
    type: validation
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: complete,handoff
      roles[1]: business-analyst
    context:
      budget_tokens: 8000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: validate
    gates[2]: terminal-evidence,next-owner
    id: handoff
    load: before-completion
    max_attempts: 1
    max_tokens: 3000
    on_failure: handoff
    operation: handoff-result
    outputs[2]: handoff,next-action
    path: steps/05-handoff.md
    reason: return gaps and one next owner
    side_effect: none
    type: handoff
version: 4.1.0
