            minLength: 1
            type: string
        type: object
      maxItems: 300
      minItems: 0
      type: array
    input_level:
      enum[5]: INITIATIVE,EPIC,FEATURE,STORY,TASK
      maxLength: 180
      minLength: 1
      type: string
    iteration:
      maximum: 3
      minimum: 1
      type: integer
    nfr_exclusions:
      items:
        properties:
          evidence:
            items:
              maxLength: 80
              minLength: 1
              pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
              type: string
            maxItems: 300
            minItems: 1
            type: array
          node:
            maxLength: 80
            minLength: 1
            pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
            type: string
          reason:
            maxLength: 180
            minLength: 1
            type: string
          requirement:
            maxLength: 80
            minLength: 1
            pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
            type: string
        type: object
      maxItems: 300
      minItems: 0
      type: array
    nodes:
