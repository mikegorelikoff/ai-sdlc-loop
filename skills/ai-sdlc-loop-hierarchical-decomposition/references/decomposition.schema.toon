            minLength: 1
            type: string
          key:
            maxLength: 80
            minLength: 1
            pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
            type: string
          reason:
            maxLength: 180
            minLength: 1
            type: string
          status:
            enum[2]: PENDING,VALIDATED
            maxLength: 180
            minLength: 1
            type: string
          validation:
            maxLength: 180
            minLength: 1
            type: string
          validation_needed:
            type: boolean
        type: object
      maxItems: 300
      minItems: 0
      type: array
    dependencies:
