          invest:
            properties:
              Estimable:
                enum[4]: PASS,FAIL,DEPENDENCY,N/A
                maxLength: 180
                minLength: 1
                type: string
              Independent:
                enum[4]: PASS,FAIL,DEPENDENCY,N/A
                maxLength: 180
                minLength: 1
                type: string
              Negotiable:
                enum[4]: PASS,FAIL,DEPENDENCY,N/A
                maxLength: 180
                minLength: 1
                type: string
              Small:
                enum[4]: PASS,FAIL,DEPENDENCY,N/A
                maxLength: 180
                minLength: 1
                type: string
              Testable:
                enum[4]: PASS,FAIL,DEPENDENCY,N/A
                maxLength: 180
                minLength: 1
                type: string
              Valuable:
                enum[4]: PASS,FAIL,DEPENDENCY,N/A
                maxLength: 180
                minLength: 1
                type: string
            type: object
          node:
            maxLength: 80
            minLength: 1
            pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
            type: string
          role:
            enum[4]: Product,Delivery,Architecture,QA
            maxLength: 180
            minLength: 1
