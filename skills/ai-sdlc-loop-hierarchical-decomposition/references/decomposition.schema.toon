"$schema": ai-sdlc-toon-contract/v1
candidate:
  properties:
    acceptance_criteria:
      items:
        properties:
          category:
            enum[6]: HAPPY,VALIDATION,ERROR,PERMISSION,TRANSITION,BOUNDARY
            maxLength: 180
            minLength: 1
            type: string
          given:
            maxLength: 180
            minLength: 1
            type: string
          key:
            maxLength: 80
            minLength: 1
            pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
            type: string
          node:
            maxLength: 80
            minLength: 1
            pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
            type: string
          requirements:
            items:
              maxLength: 80
              minLength: 1
              pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
              type: string
            maxItems: 300
            minItems: 1
            type: array
          then:
            maxLength: 180
            minLength: 1
            type: string
          verification:
            maxLength: 180
            minLength: 1
            type: string
          when:
            maxLength: 180
            minLength: 1
            type: string
        type: object
      maxItems: 300
      minItems: 0
      type: array
    assumptions:
      items:
        properties:
          confidence:
            enum[4]: LOW,MEDIUM,HIGH,UNKNOWN
            maxLength: 180
            minLength: 1
            type: string
          description:
            maxLength: 180
            minLength: 1
            type: string
          evidence:
            items:
              maxLength: 80
              minLength: 1
              pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
              type: string
            maxItems: 300
            minItems: 0
            type: array
          impact:
