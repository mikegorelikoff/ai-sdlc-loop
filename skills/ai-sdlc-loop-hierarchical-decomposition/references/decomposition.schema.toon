            maxLength: 180
            minLength: 1
            type: string
          verdict:
            enum[3]: PASS,FAIL,UNKNOWN
            maxLength: 180
            minLength: 1
            type: string
        type: object
      maxItems: 512
      minItems: 0
      type: array
    schema:
      enum[1]: ai-sdlc-decomposition-candidate/v1
      maxLength: 180
      minLength: 1
      type: string
    scope:
      maxLength: 80
      minLength: 1
      pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
      type: string
    sources:
      items:
        properties:
          content:
            maxLength: 64000
            minLength: 1
            type: string
          key:
            maxLength: 80
            minLength: 1
            pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
            type: string
          path:
            maxLength: 180
            minLength: 1
