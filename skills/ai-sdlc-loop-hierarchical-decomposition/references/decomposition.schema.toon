        properties:
          actor:
            maxLength: 180
            minLength: 0
            type: string
          assumptions:
            items:
              maxLength: 80
              minLength: 1
              pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
              type: string
            maxItems: 300
            minItems: 0
            type: array
          axis:
            enum[9]: business-capability,user-journey,workflow-stage,domain,lifecycle,integration,operational-outcome,implementation-obligation,UNKNOWN
            maxLength: 180
            minLength: 1
