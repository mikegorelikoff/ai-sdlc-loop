          key:
            maxLength: 80
            minLength: 1
            pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
            type: string
          knowledge:
            enum[4]: KNOWN,INFERRED,ASSUMED,UNKNOWN
            maxLength: 180
            minLength: 1
            type: string
          outcome:
            maxLength: 180
            minLength: 1
            type: string
          parent:
            maxLength: 180
            minLength: 0
            type: string
          priority_evidence:
            items:
              maxLength: 80
              minLength: 1
              pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
              type: string
            maxItems: 300
            minItems: 0
            type: array
          requirements:
            items:
              maxLength: 80
              minLength: 1
              pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
              type: string
            maxItems: 300
            minItems: 0
            type: array
          technical_justification:
            maxLength: 180
            minLength: 0
            type: string
          technical_outcome:
            type: boolean
          title:
            maxLength: 180
            minLength: 1
            type: string
          type:
            enum[5]: INITIATIVE,EPIC,FEATURE,STORY,TASK
            maxLength: 180
            minLength: 1
            type: string
          verification:
            maxLength: 180
            minLength: 0
            type: string
        type: object
      maxItems: 128
      minItems: 1
      type: array
    requirements:
      items:
        properties:
          key:
            maxLength: 80
            minLength: 1
            pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
            type: string
          kind:
            enum[3]: FUNCTIONAL,NFR,CONSTRAINT
            maxLength: 180
            minLength: 1
            type: string
          knowledge:
            enum[4]: KNOWN,INFERRED,ASSUMED,UNKNOWN
            maxLength: 180
            minLength: 1
            type: string
          quote:
            maxLength: 180
            minLength: 1
            type: string
          source:
            maxLength: 80
            minLength: 1
            pattern: "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
            type: string
          text:
            maxLength: 180
            minLength: 1
            type: string
        type: object
      maxItems: 300
      minItems: 0
      type: array
    reviews:
      items:
        properties:
          action:
            maxLength: 180
            minLength: 1
            type: string
          candidate_fingerprint:
            pattern: "[a-f0-9]{64}"
