budgets:
  context_max_tokens: 12000
  min_context_savings_percent: 15
  step_max_tokens: 5000
entrypoints:
  clarify[1]: context
  complete[1]: handoff
  execute[1]: execute
  handoff[1]: handoff
  prepare[1]: preflight
  route[1]: context
  validate[1]: validate
schema: ai-sdlc-skill-steps/v2
skill: ai-sdlc-loop-spec-state
steps[5]:
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: prepare
      roles[2]: product-manager,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[0]:
    gates[3]: authority,inputs,path-containment
    id: preflight
    load: required
    max_attempts: 1
    max_tokens: 1500
    on_failure: block
    operation: validate-configuration
    outputs[2]: config-status,storage-target
    path: steps/01-prepare.md
    reason: locate and validate declarative .sdlc.toon configuration
    side_effect: none
    type: analysis
  - capabilities[2]: filesystem.read,network.git
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: clarify,route
      roles[2]: product-manager,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: preflight
    gates[2]: context-sufficiency,storage-access
    id: context
    load: required
    max_attempts: 1
    max_tokens: 1000
    on_failure: block
    operation: fetch-spec-hierarchy
    outputs[3]: repository-index,baseline-spec,incremental-specs
    path: steps/02-context.md
    reason: retrieve compact specification hierarchy from configured storage
    side_effect: none
    type: context
  - capabilities[3]: filesystem.read,filesystem.write,network.git
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: execute
      roles[2]: product-manager,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: context
    gates[3]: schema-validity,conflict-detection,authorization
    id: execute
    load: on-demand
    max_attempts: 2
    max_tokens: 2000
    on_failure: block
    operation: synchronize-spec-state
    outputs[3]: staged-artifacts,published-state,rotation-receipt
    path: steps/03-execute.md
    reason: execute publish, rotate, refresh-index, or cleanup according to policy
    side_effect: workspace-write
    type: action
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: validate
      roles[2]: product-manager,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: execute
    gates[3]: output-evidence,acceptance,regression-risk
    id: validate
    load: before-completion
    max_attempts: 1
    max_tokens: 1000
    on_failure: block
    operation: validate-evidence
    outputs[2]: validation-result,retention-compliance
    path: steps/04-validate.md
    reason: validate synchronized artifacts against naming conventions and policy
    side_effect: none
    type: validation
  - capabilities[2]: filesystem.read,filesystem.write
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: handoff,complete
      roles[2]: product-manager,software-engineer
    context:
      budget_tokens: 12000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: validate
    gates[2]: terminal-evidence,next-owner
    id: handoff
    load: before-completion
    max_attempts: 1
    max_tokens: 1000
    on_failure: handoff
    operation: handoff-result
    outputs[2]: spec-state-status,downstream-context
    path: steps/05-handoff.md
    reason: emit deterministic status report and hand off context to downstream skills
    side_effect: none
    type: handoff
version: 4.1.0
