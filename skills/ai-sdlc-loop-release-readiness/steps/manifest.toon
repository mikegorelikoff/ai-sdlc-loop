budgets:
  context_max_tokens: 8000
  min_context_savings_percent: 15
  step_max_tokens: 3000
entrypoints:
  clarify[1]: context
  complete[1]: handoff
  execute[1]: assess
  handoff[1]: handoff
  prepare[1]: identify
  route[1]: context
  validate[1]: validate
schema: ai-sdlc-skill-steps/v2
skill: ai-sdlc-loop-release-readiness
steps[5]:
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: prepare
      roles[1]: product-manager
    context:
      budget_tokens: 8000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[0]:
    gates[2]: identity,gate-inventory
    id: identify
    load: required
    max_attempts: 1
    max_tokens: 3000
    on_failure: block
    operation: identify-candidate
    outputs[2]: candidate-identity,gate-inventory
    path: steps/01-identify.md
    reason: bind the release to one exact candidate
    side_effect: none
    type: analysis
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: clarify,route
      roles[1]: product-manager
    context:
      budget_tokens: 8000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: identify
    gates[2]: context-sufficiency,evidence-identity
    id: context
    load: required
    max_attempts: 1
    max_tokens: 3000
    on_failure: block
    operation: compile-context
    outputs[2]: current-evidence,missing-evidence
    path: steps/02-context.md
    reason: select evidence bound to the candidate
    side_effect: none
    type: context
  - capabilities[2]: filesystem.read,filesystem.write
    commit_boundary: after-step
    condition:
      actions[0]:
      phases[1]: execute
      roles[1]: product-manager
    context:
      budget_tokens: 8000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: context
    gates[3]: dependencies,context-sufficiency,authorization
    id: assess
    load: on-demand
    max_attempts: 1
    max_tokens: 3000
    on_failure: block
    operation: assess-release
    outputs[2]: readiness-artifact,release-decision
    path: steps/03-assess.md
    reason: record exact gates blockers and risks
    side_effect: workspace-write
    type: action
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[1]: validate
      roles[1]: product-manager
    context:
      budget_tokens: 8000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: assess
    gates[3]: identity,all-gates,blockers
    id: validate
    load: before-completion
    max_attempts: 1
    max_tokens: 3000
    on_failure: block
    operation: validate-readiness
    outputs[2]: validation-result,residual-risk
    path: steps/04-validate.md
    reason: enforce fail-closed release readiness
    side_effect: none
    type: validation
  - capabilities[1]: filesystem.read
    commit_boundary: none
    condition:
      actions[0]:
      phases[2]: complete,handoff
      roles[1]: product-manager
    context:
      budget_tokens: 8000
      critical_anchors[3]: ## Entry,## Procedure,## Exit
      fallback: direct_read
      mandatory[1]: step_document
      min_savings_percent: 15
      required: true
      selectors[4]: step,repository-instructions,feature-traces,changed-path-topology
    depends_on[1]: validate
    gates[2]: terminal-evidence,next-owner
    id: handoff
    load: before-completion
    max_attempts: 1
    max_tokens: 3000
    on_failure: handoff
    operation: handoff-result
    outputs[2]: handoff,next-action
    path: steps/05-handoff.md
    reason: return release decision without publishing
    side_effect: none
    type: handoff
version: 4.1.0
